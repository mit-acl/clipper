[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "clipperpy"
version = "${PROJECT_VERSION}"
description = "Robust data association framework"
authors = [
    {name = "Parker Lusk", email = "plusk@mit.edu"},
]

[tool.setuptools]
packages = ["clipperpy"]

[tool.setuptools.package-data]
"*" = ["*.so"]
